.bottom-nav{position:fixed;bottom:0;left:0;right:0;height:100rpx;background:#fff;display:flex;justify-content:space-around;align-items:center;box-shadow:0 -2rpx 12rpx rgba(0,0,0,0.06);z-index:1000;padding-bottom:env(safe-area-inset-bottom)}
.nav-item{display:flex;flex-direction:column;align-items:center;gap:4rpx;padding:8rpx 16rpx;font-size:22rpx;color:#999}
.nav-item.active{color:#7C3AED;font-weight:600}
.nav-icon{font-size:36rpx}
.nav-label{font-size:20rpx}
