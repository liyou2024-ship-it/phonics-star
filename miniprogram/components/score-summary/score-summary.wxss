.summary {
  padding: 48rpx 32rpx;
  background: #fff;
  border-radius: 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.08);
}
.summary__score-circle {
  width: 200rpx; height: 200rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7C3AED, #A78BFA);
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  margin: 0 auto 24rpx;
}
.summary__percent { font-size: 48rpx; color: #fff; font-weight: 700; }
.summary__label { font-size: 22rpx; color: rgba(255,255,255,0.8); }
.summary__stats { margin-bottom: 24rpx; }
.summary__stat { display: block; font-size: 28rpx; margin: 8rpx 0; color: #555; }
.summary__stars { font-size: 40rpx; margin-bottom: 32rpx; }
.summary__star-empty { opacity: 0.3; }
.summary__actions { display: flex; gap: 24rpx; justify-content: center; }
.summary__btn {
  flex: 1; max-width: 240rpx;
  height: 80rpx; line-height: 80rpx;
  border-radius: 40rpx; font-size: 28rpx;
}
.summary__btn--retry { background: #7C3AED; color: #fff; }
.summary__btn--home { background: #f0f0f0; color: #333; }
