.modal {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  display: flex; align-items: center; justify-content: center;
  z-index: 1000;
}
.modal__overlay {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
}
.modal__card {
  position: relative; padding: 48rpx 40rpx;
  background: #fff; border-radius: 24rpx;
  text-align: center; min-width: 500rpx;
  animation: modalIn 0.3s ease-out;
}
@keyframes modalIn {
  from { transform: scale(0.8); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}
.modal__stars { font-size: 48rpx; margin-bottom: 16rpx; }
.modal__star { opacity: 0.2; margin: 0 4rpx; }
.modal__star--active { opacity: 1; }
.modal__title { font-size: 40rpx; font-weight: 700; color: #7C3AED; display: block; margin-bottom: 8rpx; }
.modal__message { font-size: 28rpx; color: #666; display: block; margin-bottom: 16rpx; }
.modal__badges { margin-bottom: 24rpx; }
.modal__badge { display: block; font-size: 28rpx; margin: 8rpx 0; }
.modal__btn {
  width: 240rpx; height: 80rpx; line-height: 80rpx;
  background: #7C3AED; color: #fff;
  border-radius: 40rpx; font-size: 30rpx;
}
