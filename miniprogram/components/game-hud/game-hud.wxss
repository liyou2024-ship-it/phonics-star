.hud {
  display: flex; align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(10rpx);
  border-radius: 0 0 16rpx 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  position: relative;
}
.hud__item { text-align: center; flex: 1; }
.hud__label { font-size: 20rpx; color: #999; display: block; margin-bottom: 4rpx; }
.hud__value { font-size: 28rpx; font-weight: 700; color: #333; }
.hud__value--score { color: #7C3AED; }
.hud__combo {
  position: absolute; right: 24rpx; top: -24rpx;
  background: #FF6B35; color: #fff;
  font-size: 22rpx; padding: 4rpx 16rpx;
  border-radius: 20rpx;
  animation: comboBounce 0.4s ease-out;
}
@keyframes comboBounce {
  0% { transform: scale(0.5); }
  60% { transform: scale(1.2); }
  100% { transform: scale(1); }
}
