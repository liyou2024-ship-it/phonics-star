.whack-mole{padding:24rpx;min-height:100vh;background:linear-gradient(180deg,#FEF3C7 0%,#FFF7ED 50%,#FEE2E2 100%)}

.hud{display:flex;justify-content:space-between;align-items:center;background:rgba(255,255,255,0.9);border-radius:16rpx;padding:16rpx 24rpx;margin-bottom:32rpx;backdrop-filter:blur(4px)}
.hud-round{font-size:28rpx;font-weight:700;color:#92400E}
.hud-score{font-size:28rpx;font-weight:700;color:#DC2626}
.hud-combo{font-size:28rpx;font-weight:700;color:#7C3AED}

.target-hint{text-align:center;margin-bottom:32rpx}
.hint-text{font-size:30rpx;color:#6B7280;display:block}
.replay-btn{margin-top:16rpx;display:inline-flex;align-items:center;gap:8rpx;background:#7C3AED;color:#fff;padding:12rpx 28rpx;border-radius:32rpx;font-size:26rpx}

.feedback-toast{position:fixed;top:40%;left:50%;transform:translate(-50%,-50%);z-index:100;display:flex;flex-direction:column;align-items:center;padding:32rpx 48rpx;border-radius:24rpx;animation:popIn 0.3s ease}
.feedback-toast.correct{background:#D1FAE5;box-shadow:0 4rpx 20rpx rgba(16,185,129,0.3)}
.feedback-toast.wrong{background:#FEE2E2;box-shadow:0 4rpx 20rpx rgba(239,68,68,0.3)}
.feedback-emoji{font-size:64rpx}
.feedback-letter{font-size:48rpx;font-weight:800;margin-top:8rpx;color:#1F2937}

@keyframes popIn{0%{transform:translate(-50%,-50%) scale(0.5);opacity:0}100%{transform:translate(-50%,-50%) scale(1);opacity:1}}

.mole-grid{display:flex;justify-content:center;gap:24rpx;flex-wrap:wrap;padding:0 16rpx}
.mole-card{width:180rpx;height:180rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:transform 0.15s,box-shadow 0.15s;box-shadow:0 6rpx 20rpx rgba(0,0,0,0.1)}
.mole-card:nth-child(1){background:linear-gradient(135deg,#F59E0B,#FCD34D)}
.mole-card:nth-child(2){background:linear-gradient(135deg,#8B5CF6,#A78BFA)}
.mole-card:nth-child(3){background:linear-gradient(135deg,#EC4899,#F472B6)}
.mole-card:active{transform:scale(0.92)}
.mole-card.hit-correct{background:linear-gradient(135deg,#10B981,#6EE7B7)!important;transform:scale(1.05)}
.mole-card.hit-wrong{background:linear-gradient(135deg,#EF4444,#FCA5A5)!important;transform:scale(0.95)}
.mole-letter{font-size:52rpx;font-weight:800;color:#fff;text-shadow:0 2rpx 4rpx rgba(0,0,0,0.15)}

.game-over{display:flex;flex-direction:column;align-items:center;padding:48rpx 32rpx}
.go-title{font-size:40rpx;font-weight:800;color:#1F2937;margin-bottom:32rpx}
.go-summary{display:flex;flex-direction:column;align-items:center;gap:12rpx;margin-bottom:40rpx;background:#fff;padding:32rpx 48rpx;border-radius:20rpx;box-shadow:0 2rpx 12rpx rgba(0,0,0,0.06)}
.go-score{font-size:48rpx;font-weight:800;color:#DC2626}
.go-stat{font-size:28rpx;color:#6B7280}
.go-btn{background:linear-gradient(135deg,#7C3AED,#8B5CF6);color:#fff;padding:20rpx 64rpx;border-radius:40rpx;font-size:32rpx;font-weight:700;box-shadow:0 4rpx 16rpx rgba(124,58,237,0.3)}
