.word-fishing{padding:24rpx;min-height:100vh;background:linear-gradient(180deg,#DBEAFE 0%,#BFDBFE 40%,#93C5FD 100%)}

.hud{display:flex;justify-content:space-between;align-items:center;background:rgba(255,255,255,0.85);border-radius:16rpx;padding:16rpx 24rpx;margin-bottom:24rpx;backdrop-filter:blur(4px)}
.hud-round{font-size:28rpx;font-weight:700;color:#1E40AF}
.hud-score{font-size:28rpx;font-weight:700;color:#DC2626}
.hud-caught{font-size:28rpx;font-weight:700;color:#059669}

.target-section{text-align:center;margin-bottom:24rpx}
.target-label{font-size:28rpx;color:#6B7280;display:block}
.target-word-box{margin:16rpx auto;display:inline-block;background:#fff;padding:16rpx 40rpx;border-radius:20rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,0.08);border:3rpx solid #93C5FD}
.target-word{font-size:40rpx;font-weight:800;color:#1E40AF}
.replay-btn{margin-top:12rpx;display:inline-flex;align-items:center;gap:8rpx;background:#2563EB;color:#fff;padding:12rpx 28rpx;border-radius:32rpx;font-size:26rpx}

.feedback-toast{position:fixed;top:40%;left:50%;transform:translate(-50%,-50%);z-index:100;display:flex;flex-direction:column;align-items:center;padding:32rpx 48rpx;border-radius:24rpx;animation:popIn 0.3s ease}
.feedback-toast.correct{background:#D1FAE5;box-shadow:0 4rpx 20rpx rgba(16,185,129,0.3)}
.feedback-toast.wrong{background:#FEE2E2;box-shadow:0 4rpx 20rpx rgba(239,68,68,0.3)}
.feedback-emoji{font-size:64rpx}
.feedback-word{font-size:48rpx;font-weight:800;margin-top:8rpx;color:#1F2937}

@keyframes popIn{0%{transform:translate(-50%,-50%) scale(0.5);opacity:0}100%{transform:translate(-50%,-50%) scale(1);opacity:1}}

/* Pond */
.pond{display:flex;flex-wrap:wrap;justify-content:center;gap:24rpx;padding:32rpx 16rpx;background:rgba(255,255,255,0.3);border-radius:24rpx;min-height:300rpx;align-items:center}
.fish-card{width:140rpx;height:160rpx;background:#fff;border-radius:40rpx 40rpx 20rpx 20rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,0.08);cursor:pointer;transition:transform 0.15s;animation:float 2s ease-in-out infinite}
.fish-card:nth-child(2){animation-delay:0.3s}
.fish-card:nth-child(3){animation-delay:0.6s}
.fish-card:nth-child(4){animation-delay:0.9s}
.fish-card:active{transform:scale(0.92)}
.fish-card.fish-correct{background:#D1FAE5;border:3rpx solid #10B981}
.fish-card.fish-wrong{background:#FEE2E2;border:3rpx solid #EF4444}
.fish-emoji{font-size:44rpx}
.fish-word{font-size:28rpx;font-weight:700;color:#1E40AF;text-transform:lowercase}

@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-8rpx)}}

.game-over{display:flex;flex-direction:column;align-items:center;padding:48rpx 32rpx;margin-top:24rpx}
.go-title{font-size:40rpx;font-weight:800;color:#1F2937;margin-bottom:32rpx}
.go-summary{display:flex;flex-direction:column;align-items:center;gap:12rpx;margin-bottom:40rpx;background:#fff;padding:32rpx 48rpx;border-radius:20rpx;box-shadow:0 2rpx 12rpx rgba(0,0,0,0.06)}
.go-score{font-size:48rpx;font-weight:800;color:#DC2626}
.go-stat{font-size:28rpx;color:#6B7280}
.go-btn{background:linear-gradient(135deg,#2563EB,#3B82F6);color:#fff;padding:20rpx 64rpx;border-radius:40rpx;font-size:32rpx;font-weight:700;box-shadow:0 4rpx 16rpx rgba(37,99,235,0.3)}
