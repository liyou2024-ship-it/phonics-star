.pron-practice{padding:24rpx 0;display:flex;flex-direction:column;align-items:center}

/* 录音区域 */
.record-section{display:flex;flex-direction:column;align-items:center;padding:80rpx 0}
.mic-btn{width:200rpx;height:200rpx;border-radius:50%;background:linear-gradient(135deg,#7C3AED,#A78BFA);display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:0 8rpx 30rpx rgba(124,58,237,0.3);transition:transform 0.15s}
.mic-btn.recording{background:linear-gradient(135deg,#EF4444,#F87171);animation:mic-pulse 1.2s ease-in-out infinite}
.mic-icon{font-size:64rpx}
.mic-label{font-size:24rpx;color:#fff;margin-top:8rpx;font-weight:600}
.recording-indicator{margin-top:32rpx;position:relative;display:flex;align-items:center;justify-content:center}
.pulse-ring{width:40rpx;height:40rpx;border-radius:50%;background:#EF4444;opacity:0.6;animation:pulse-ring 1s ease-out infinite}
.duration-text{font-size:40rpx;font-weight:800;color:#374151;margin-left:16rpx}

@keyframes mic-pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.06)}}
@keyframes pulse-ring{0%{transform:scale(0.8);opacity:0.8}100%{transform:scale(2.5);opacity:0}}

/* 已录音 */
.recorded-section{display:flex;flex-direction:column;align-items:center;padding:60rpx 0;width:100%}
.section-title{font-size:28rpx;font-weight:700;color:#1F2937;margin-bottom:24rpx}
.action-row{display:flex;gap:24rpx;margin-bottom:24rpx}
.action-btn{font-size:28rpx;font-weight:700;border-radius:40rpx;padding:20rpx 40rpx;border:none}
.play-btn{background:#F3F4F6;color:#374151}
.eval-btn{background:linear-gradient(135deg,#F59E0B,#FBBF24);color:#fff}
.retry-btn{font-size:26rpx;color:#9CA3AF;padding:12rpx}

/* 评测中 */
.evaluating-section{display:flex;flex-direction:column;align-items:center;padding:80rpx 0}
.loading-spinner{width:60rpx;height:60rpx;border:6rpx solid #E5E7EB;border-top-color:#7C3AED;border-radius:50%;animation:spin 0.8s linear infinite;margin-bottom:24rpx}
@keyframes spin{to{transform:rotate(360deg)}}
.eval-loading-text{font-size:28rpx;color:#6B7280;font-weight:600}

/* 评测结果 */
.eval-result-section{display:flex;flex-direction:column;align-items:center;width:100%;padding:24rpx 0}
.score-circle{width:180rpx;height:180rpx;border-radius:50%;background:linear-gradient(135deg,#10B981,#34D399);display:flex;flex-direction:column;align-items:center;justify-content:center;margin-bottom:16rpx;box-shadow:0 8rpx 24rpx rgba(16,185,129,0.3)}
.score-number{font-size:72rpx;font-weight:900;color:#fff;line-height:1}
.score-label{font-size:24rpx;color:rgba(255,255,255,0.8)}
.feedback-text{font-size:30rpx;font-weight:700;color:#1F2937;text-align:center;margin-bottom:24rpx;padding:0 32rpx}

/* 分项得分 */
.detail-scores{display:flex;gap:24rpx;margin-bottom:32rpx}
.detail-item{display:flex;flex-direction:column;align-items:center;background:#F9FAFB;border-radius:16rpx;padding:16rpx 28rpx}
.detail-label{font-size:22rpx;color:#9CA3AF;margin-bottom:4rpx}
.detail-value{font-size:32rpx;font-weight:800;color:#374151}

/* 音素列表 */
.phoneme-list{width:100%;margin-bottom:32rpx}
.phoneme-item{background:#F9FAFB;border-radius:16rpx;padding:20rpx;margin-bottom:12rpx}
.phoneme-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12rpx}
.phoneme-symbol{font-size:32rpx;font-weight:800;color:#7C3AED}
.phoneme-pass{font-size:28rpx}
.accuracy-bar-bg{height:12rpx;background:#E5E7EB;border-radius:6rpx;overflow:hidden;margin-bottom:8rpx}
.accuracy-bar-fill{height:100%;border-radius:6rpx;transition:width 0.8s ease}
.fill-pass{background:linear-gradient(90deg,#10B981,#34D399)}
.fill-fail{background:linear-gradient(90deg,#F59E0B,#FBBF24)}
.accuracy-text{font-size:22rpx;color:#6B7280;margin-bottom:6rpx}
.phoneme-feedback{font-size:24rpx;color:#6B7280}

/* 底部按钮 */
.bottom-actions{display:flex;gap:24rpx;width:100%}
.retry-outline-btn{flex:1;background:#fff;border:2rpx solid #D1D5DB;border-radius:40rpx;padding:22rpx;font-size:28rpx;font-weight:700;color:#6B7280}
.complete-btn{flex:1;background:linear-gradient(135deg,#10B981,#34D399);color:#fff;border:none;border-radius:40rpx;padding:22rpx;font-size:28rpx;font-weight:800}
