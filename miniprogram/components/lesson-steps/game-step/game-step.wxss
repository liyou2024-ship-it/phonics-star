.game-step{padding:24rpx 0;display:flex;flex-direction:column;align-items:center;min-height:500rpx}

/* 开始界面 */
.start-section{display:flex;flex-direction:column;align-items:center;padding:100rpx 0}
.game-title{font-size:52rpx;font-weight:900;color:#1F2937;margin-bottom:16rpx}
.game-desc{font-size:26rpx;color:#6B7280;margin-bottom:48rpx}
.start-btn{background:linear-gradient(135deg,#F59E0B,#FBBF24);color:#fff;border:none;border-radius:40rpx;padding:24rpx 64rpx;font-size:32rpx;font-weight:800}

/* 游戏 HUD */
.game-hud{display:flex;justify-content:space-between;align-items:center;width:100%;margin-bottom:48rpx;padding:0 16rpx}
.round-text{font-size:28rpx;font-weight:700;color:#6B7280}
.score-text{font-size:32rpx;font-weight:800;color:#F59E0B}

/* 卡片网格 */
.mole-grid{display:flex;flex-wrap:wrap;gap:24rpx;justify-content:center;width:100%}
.mole-card{width:200rpx;height:200rpx;border-radius:24rpx;background:#F3F4F6;display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;transition:transform 0.15s,box-shadow 0.15s;box-shadow:0 4rpx 12rpx rgba(0,0,0,0.06)}
.mole-card.active{transform:translateY(-8rpx);box-shadow:0 12rpx 30rpx rgba(0,0,0,0.12)}
.mole-card.hit-correct{background:linear-gradient(135deg,#D1FAE5,#A7F3D0)}
.mole-card.hit-wrong{background:linear-gradient(135deg,#FEE2E2,#FECACA)}
.mole-word{font-size:36rpx;font-weight:800;color:#374151}
.hit-mark{position:absolute;top:8rpx;right:8rpx;font-size:32rpx}

/* 结果界面 */
.result-section{display:flex;flex-direction:column;align-items:center;padding:60rpx 0}
.result-title{font-size:44rpx;font-weight:900;color:#1F2937;margin-bottom:32rpx}
.result-stats{display:flex;gap:48rpx;margin-bottom:48rpx}
.stat-item{display:flex;flex-direction:column;align-items:center}
.stat-value{font-size:48rpx;font-weight:900;color:#7C3AED}
.stat-label{font-size:24rpx;color:#9CA3AF;margin-top:4rpx}
.play-again-btn{background:linear-gradient(135deg,#7C3AED,#A78BFA);color:#fff;border:none;border-radius:40rpx;padding:22rpx 56rpx;font-size:28rpx;font-weight:800}
