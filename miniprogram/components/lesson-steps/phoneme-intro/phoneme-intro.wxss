.phoneme-intro{padding:24rpx 0}
.state-error{text-align:center;padding:60rpx;color:#EF4444;font-size:28rpx}
.intro-card{display:flex;flex-direction:column;align-items:center;background:linear-gradient(135deg,#F5F3FF,#EDE9FE);border-radius:32rpx;padding:48rpx 32rpx;margin-bottom:24rpx}
.intro-letters{display:flex;gap:16rpx;margin-bottom:16rpx}
.intro-capital{font-size:120rpx;font-weight:900;color:#7C3AED;line-height:1}
.intro-symbol{font-size:56rpx;font-weight:800;color:#A78BFA}
.intro-play-hint{font-size:26rpx;color:#7C3AED;margin-top:16rpx;font-weight:600}
.intro-mouth-tip{display:flex;gap:12rpx;background:#FEF3C7;border-radius:16rpx;padding:20rpx;margin-bottom:24rpx;align-items:flex-start}
.tip-icon{font-size:36rpx;flex-shrink:0}
.tip-text{font-size:26rpx;color:#92400E;line-height:1.6}
.words-title{font-size:28rpx;font-weight:800;color:#1F2937;display:block;margin-bottom:16rpx}
.words-list{display:flex;flex-direction:column;gap:12rpx;margin-bottom:24rpx}
.word-item{display:flex;align-items:center;background:#fff;border-radius:16rpx;padding:20rpx;gap:12rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,0.04)}
.word-text{font-size:32rpx;font-weight:800;color:#7C3AED}
.word-meaning{font-size:24rpx;color:#6B7280;flex:1}
.word-play{font-size:32rpx}
.words-empty{text-align:center;padding:32rpx;color:#9CA3AF;font-size:26rpx}
.complete-btn{width:100%;background:linear-gradient(135deg,#10B981,#34D399);color:#fff;border:none;border-radius:40rpx;padding:24rpx;font-size:32rpx;font-weight:800;margin-top:16rpx}
