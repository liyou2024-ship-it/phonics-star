.segmenter{padding:16rpx 0}
.done{text-align:center;padding:60rpx;font-size:32rpx;font-weight:700}
.sg-header{display:flex;align-items:center;gap:12rpx;margin-bottom:24rpx;font-size:28rpx}
.sg-word{font-size:40rpx;font-weight:900;color:#7C3AED}
.sg-progress{margin-left:auto;color:#9CA3AF}
.sg-slots{display:flex;gap:12rpx;justify-content:center;margin-bottom:24rpx}
.sg-slot{width:80rpx;height:100rpx;display:flex;align-items:center;justify-content:center;background:#F5F3FF;border-radius:16rpx;font-size:32rpx;font-weight:800;color:#7C3AED;border:2rpx dashed #C4B5FD}
.sg-slot .empty{color:#D1D5DB}
.sg-options{display:flex;gap:12rpx;justify-content:center;flex-wrap:wrap;margin-bottom:20rpx}
.sg-opt{display:flex;align-items:center;justify-content:center;background:#fff;border:2rpx solid #E5E7EB;border-radius:16rpx;padding:16rpx 24rpx;font-size:28rpx;font-weight:700;color:#1F2937}
.sg-actions{display:flex;gap:8rpx}
.sg-actions button{flex:1;background:#F3F4F6;border:none;border-radius:32rpx;padding:16rpx;font-size:26rpx}
.sg-actions .submit{background:linear-gradient(135deg,#10B981,#34D399);color:#fff}
.sg-feedback{text-align:center;padding:16rpx;margin-top:16rpx;border-radius:12rpx;font-size:28rpx;font-weight:700}
.sg-feedback.ok{background:#D1FAE5;color:#065F46}
.sg-feedback.err{background:#FEE2E2;color:#991B1B}
