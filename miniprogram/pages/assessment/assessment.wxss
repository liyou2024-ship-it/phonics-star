.page{padding:24rpx;background:#FAFAFA;min-height:100vh}
.intro{display:flex;flex-direction:column;align-items:center;padding:80rpx 32rpx;text-align:center}
.intro-icon{font-size:96rpx;margin-bottom:24rpx}
.intro-title{font-size:40rpx;font-weight:900;color:#7C3AED;margin-bottom:16rpx}
.intro-desc{font-size:28rpx;color:#6B7280;margin-bottom:32rpx}
.intro-rules{display:flex;flex-direction:column;gap:8rpx;font-size:26rpx;color:#6B7280;margin-bottom:40rpx;text-align:left}
.start-btn{width:100%;background:linear-gradient(135deg,#7C3AED,#A78BFA);color:#fff;border:none;border-radius:40rpx;padding:24rpx;font-size:32rpx;font-weight:800}
.testing{padding:0}
.question-card{margin-top:32rpx}
.q-audio-btn{display:block;width:fit-content;margin:0 auto 24rpx;background:#F5F3FF;color:#7C3AED;font-size:26rpx;font-weight:700;padding:12rpx 28rpx;border-radius:32rpx}
.q-audio-btn:active{opacity:.7}
.q-prompt{font-size:32rpx;font-weight:700;color:#1F2937;display:block;margin-bottom:24rpx;text-align:center}
.q-options{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}
.q-option{display:flex;align-items:center;justify-content:center;background:#fff;border:3rpx solid #E5E7EB;border-radius:20rpx;padding:32rpx;transition:all 0.15s}
.q-option:active{transform:scale(0.95);background:#F5F3FF;border-color:#7C3AED}
.q-option-text{font-size:48rpx;font-weight:900;color:#1F2937}
.result{padding-bottom:40rpx}
.result-detail,.result-suggestion{margin-bottom:20rpx}
.card{background:#fff;border-radius:20rpx;padding:24rpx;box-shadow:0 2rpx 12rpx rgba(0,0,0,0.04)}
.section-title{font-size:28rpx;font-weight:800;color:#1F2937;display:block;margin-bottom:16rpx}
.ability-item{display:flex;justify-content:space-between;padding:12rpx 0;border-bottom:1rpx solid #F3F4F6;font-size:26rpx}
.ability-value{font-weight:700;color:#7C3AED}
.suggestion-text{font-size:26rpx;color:#6B7280;line-height:1.6}
.btn{padding:20rpx 32rpx;border-radius:40rpx;font-size:28rpx;font-weight:700;width:100%;margin-top:16rpx}
.btn-secondary{background:#F3E8FF;color:#7C3AED;border:none}
