<view class="lesson-page">
  <!-- Loading -->
  <view wx:if="{{engineState.loading}}" class="state"><text>加载中...</text></view>

  <!-- Error -->
  <view wx:elif="{{engineState.error}}" class="state">
    <empty-state icon="😵" title="加载失败" desc="{{engineState.error}}"></empty-state>
    <button bindtap="onBack">返回</button>
  </view>

  <!-- Normal -->
  <view wx:else>
    <!-- Header: lesson title + progress -->
    <view class="lesson-header">
      <text class="back-btn" bindtap="onBack">←</text>
      <view class="lesson-title-area">
        <text class="lesson-title">{{engineState.lesson.title}}</text>
      </view>
    </view>

    <!-- Step progress bar -->
    <view wx:if="{{engineState.lesson}}" class="step-progress">
      <progress-bar
        value="{{engineState.currentStepIndex + 1}}"
        max="{{engineState.lesson.steps.length}}"
        label="步骤 {{engineState.currentStepIndex + 1}} / {{engineState.lesson.steps.length}}"
      ></progress-bar>
    </view>

    <!-- Dynamic step component rendering -->
    <view wx:if="{{engineState.lesson}}" class="step-area">
      <!-- phoneme_intro -->
      <phoneme-intro
        wx:if="{{currentComponentName === 'phoneme-intro'}}"
        step="{{currentComponentProps.step}}"
        lesson="{{currentComponentProps.lesson}}"
        state="{{currentComponentProps.state}}"
        bind:complete="onStepComplete"
      ></phoneme-intro>

      <!-- sound_discrimination / audio_choice -->
      <audio-choice
        wx:elif="{{currentComponentName === 'audio-choice'}}"
        step="{{currentComponentProps.step}}"
        lesson="{{currentComponentProps.lesson}}"
        state="{{currentComponentProps.state}}"
        bind:complete="onStepComplete"
      ></audio-choice>

      <!-- phoneme_blending / blend_word -->
      <blend-builder
        wx:elif="{{currentComponentName === 'blend-builder'}}"
        step="{{currentComponentProps.step}}"
        lesson="{{currentComponentProps.lesson}}"
        state="{{currentComponentProps.state}}"
        bind:complete="onStepComplete"
      ></blend-builder>

      <!-- word_segmenting / segment_word -->
      <sound-segmenter
        wx:elif="{{currentComponentName === 'sound-segmenter'}}"
        step="{{currentComponentProps.step}}"
        lesson="{{currentComponentProps.lesson}}"
        state="{{currentComponentProps.state}}"
        bind:complete="onStepComplete"
      ></sound-segmenter>

      <!-- pronunciation -->
      <pronunciation-practice
        wx:elif="{{currentComponentName === 'pronunciation-practice'}}"
        step="{{currentComponentProps.step}}"
        lesson="{{currentComponentProps.lesson}}"
        state="{{currentComponentProps.state}}"
        bind:complete="onStepComplete"
      ></pronunciation-practice>

      <!-- mini_game -->
      <game-step
        wx:elif="{{currentComponentName === 'game-step'}}"
        step="{{currentComponentProps.step}}"
        lesson="{{currentComponentProps.lesson}}"
        state="{{currentComponentProps.state}}"
        bind:complete="onStepComplete"
      ></game-step>

      <!-- decodable_reading -->
      <decodable-reader
        wx:elif="{{currentComponentName === 'decodable-reader'}}"
        step="{{currentComponentProps.step}}"
        lesson="{{currentComponentProps.lesson}}"
        state="{{currentComponentProps.state}}"
        bind:complete="onStepComplete"
      ></decodable-reader>

      <!-- lesson_reward -->
      <lesson-reward
        wx:elif="{{currentComponentName === 'lesson-reward'}}"
        step="{{currentComponentProps.step}}"
        lesson="{{currentComponentProps.lesson}}"
        state="{{currentComponentProps.state}}"
        stepResults="{{currentComponentProps.stepResults}}"
        bind:complete="onStepComplete"
      ></lesson-reward>

      <!-- Fallback: 仅当遇到未知步骤类型，提供跳过出口避免卡死 -->
      <view wx:elif="{{currentComponentName === '__unsupported__'}}" class="step-fallback">
        <text>该步骤（{{currentComponentProps.step.type}}）暂不支持</text>
        <button bindtap="onSkipStep">跳过此步骤</button>
      </view>
    </view>
  </view>
</view>
