.lesson-page{min-height:100vh;background:#FAFAFA;padding-bottom:40rpx}
.state{display:flex;flex-direction:column;align-items:center;justify-content:center;height:60vh;gap:20rpx}
.lesson-header{display:flex;align-items:center;gap:16rpx;padding:24rpx;background:#fff}
.back-btn{font-size:40rpx;color:#7C3AED;padding:8rpx}
.lesson-title{font-size:34rpx;font-weight:800;color:#1F2937}
.step-progress{padding:16rpx 24rpx}
.step-area{padding:0 24rpx;min-height:60vh}
.step-fallback{text-align:center;padding:100rpx 0;color:#9CA3AF;font-size:28rpx}
