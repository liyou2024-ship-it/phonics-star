/* 练习中心 */
.page { padding: 24rpx 24rpx 120rpx; background: #FAFAFA; min-height: 100vh; }
.page-header { margin-bottom: 24rpx; }
.page-title { font-size: 36rpx; font-weight: 800; color: #1F2937; }

/* 模式选项卡 */
.mode-tabs {
  display: flex; gap: 8rpx; margin-bottom: 32rpx;
  overflow-x: auto; -webkit-overflow-scrolling: touch;
}
.mode-tab {
  padding: 14rpx 22rpx; border-radius: 32rpx; background: #fff;
  font-size: 26rpx; font-weight: 600; white-space: nowrap;
  transition: all 0.2s; flex-shrink: 0;
}
.mode-tab.active { background: #7C3AED; color: #fff; }

/* 加载 / 错误 */
.loading-state, .error-state { padding: 120rpx 0; text-align: center; color: #9CA3AF; font-size: 28rpx; }
.error-text { display: block; color: #EF4444; margin-bottom: 24rpx; }

/* 选择阶段 */
.select-phase { padding: 60rpx 0; display: flex; justify-content: center; }
.select-card {
  background: #fff; border-radius: 24rpx; padding: 48rpx 32rpx;
  text-align: center; width: 100%; max-width: 560rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.select-icon { font-size: 72rpx; display: block; margin-bottom: 24rpx; }
.select-desc { font-size: 28rpx; color: #6B7280; display: block; margin-bottom: 40rpx; line-height: 1.6; }

.start-btn {
  display: inline-block; background: #7C3AED; color: #fff;
  padding: 20rpx 64rpx; border-radius: 48rpx; font-size: 30rpx; font-weight: 700;
}

/* 答题阶段 */
.question-phase { padding-bottom: 24rpx; }

.progress-bar {
  height: 8rpx; background: #E5E7EB; border-radius: 4rpx;
  margin-bottom: 8rpx; overflow: hidden;
}
.progress-fill { height: 100%; background: #7C3AED; border-radius: 4rpx; transition: width 0.3s; }
.progress-text { font-size: 24rpx; color: #9CA3AF; display: block; margin-bottom: 32rpx; }

.question-prompt {
  font-size: 32rpx; font-weight: 700; color: #1F2937;
  text-align: center; margin-bottom: 32rpx;
}

.audio-btn {
  display: flex; flex-direction: column; align-items: center;
  padding: 32rpx; background: #EDE9FE; border-radius: 16rpx;
  margin-bottom: 32rpx; font-size: 28rpx; font-weight: 600; color: #7C3AED;
}
.audio-disabled { background: #F3F4F6; color: #9CA3AF; }
.audio-tip { font-size: 22rpx; color: #9CA3AF; margin-top: 8rpx; font-weight: 400; }

/* 选项网格 */
.options-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx;
}
.option-card {
  background: #fff; border: 3rpx solid #E5E7EB; border-radius: 16rpx;
  padding: 36rpx 16rpx; text-align: center;
  font-size: 36rpx; font-weight: 700; color: #374151;
  transition: all 0.2s;
}
.option-card.option-correct { background: #D1FAE5; border-color: #10B981; color: #065F46; }
.option-card.option-wrong { background: #FEE2E2; border-color: #EF4444; color: #991B1B; }

/* 反馈区域 */
.feedback-area {
  margin-top: 32rpx; padding: 32rpx; border-radius: 16rpx;
  text-align: center;
}
.feedback-correct { background: #D1FAE5; }
.feedback-wrong { background: #FEE2E2; }
.feedback-icon { font-size: 48rpx; display: block; margin-bottom: 12rpx; }
.feedback-text { font-size: 30rpx; font-weight: 700; display: block; margin-bottom: 12rpx; }
.feedback-correct .feedback-text { color: #065F46; }
.feedback-wrong .feedback-text { color: #991B1B; }
.explanation-text { font-size: 26rpx; color: #6B7280; display: block; margin-bottom: 24rpx; line-height: 1.5; }

.next-btn, .retry-btn {
  display: inline-block; background: #7C3AED; color: #fff;
  padding: 16rpx 56rpx; border-radius: 48rpx; font-size: 28rpx; font-weight: 600;
}

/* 结果阶段 */
.result-phase {
  padding: 80rpx 0; text-align: center;
  background: #fff; border-radius: 24rpx; margin-top: 40rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.result-icon { font-size: 80rpx; display: block; margin-bottom: 16rpx; }
.result-score { font-size: 56rpx; font-weight: 800; color: #7C3AED; display: block; margin-bottom: 12rpx; }
.result-detail { font-size: 28rpx; color: #6B7280; display: block; margin-bottom: 40rpx; }
.result-btns { display: flex; gap: 24rpx; justify-content: center; }

.error-btn {
  display: inline-block; background: #F3F4F6; color: #374151;
  padding: 16rpx 56rpx; border-radius: 48rpx; font-size: 28rpx; font-weight: 600;
}

/* 空状态 */
.empty-phase { padding: 120rpx 0; text-align: center; }
.go-practice-btn {
  display: inline-block; background: #7C3AED; color: #fff;
  padding: 16rpx 56rpx; border-radius: 48rpx; font-size: 28rpx; font-weight: 600;
  margin-top: 24rpx;
}
