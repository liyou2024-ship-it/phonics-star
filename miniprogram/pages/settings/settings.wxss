.page{padding:24rpx 24rpx 60rpx;background:#FAFAFA;min-height:100vh}
.page-header{display:flex;flex-direction:column;align-items:center;padding:40rpx 0;background:linear-gradient(135deg,#7C3AED,#A78BFA);border-radius:24rpx;margin-bottom:20rpx}
.avatar{width:100rpx;height:100rpx;border-radius:50%;background:rgba(255,255,255,0.3);color:#fff;font-size:44rpx;font-weight:800;display:flex;align-items:center;justify-content:center;margin-bottom:16rpx}
.title{font-size:36rpx;font-weight:800;color:#fff}
.sub{font-size:22rpx;color:rgba(255,255,255,0.85);margin-top:6rpx}

.account-card{background:#fff;border-radius:24rpx;overflow:hidden;box-shadow:0 2rpx 12rpx rgba(0,0,0,0.04)}
.card-title{font-size:28rpx;font-weight:800;color:#1F2937;padding:24rpx 24rpx 8rpx}
.account-card .menu-item:last-child{border-bottom:none}
.account-card .menu-item{display:flex;align-items:center;gap:16rpx;padding:28rpx 24rpx;border-bottom:1rpx solid #F3F4F6;font-size:28rpx}
.account-card .mi-icon{font-size:32rpx;width:44rpx}
.account-card .mi-label{font-size:28rpx;color:#1F2937}
.account-card .mi-arrow{margin-left:auto;color:#9CA3AF}
.account-card .mi-value{margin-left:auto;color:#7C3AED;font-size:26rpx}
.account-card .menu-item.danger .mi-label{color:#EF4444}

/* 修改密码弹窗 */
.modal-mask{position:fixed;left:0;top:0;right:0;bottom:0;background:rgba(0,0,0,0.45);display:flex;align-items:center;justify-content:center;z-index:100}
.modal{width:600rpx;background:#fff;border-radius:24rpx;padding:40rpx 32rpx;box-sizing:border-box}
.modal-title{font-size:32rpx;font-weight:800;color:#1F2937;text-align:center;margin-bottom:28rpx}
.modal-input{width:100%;height:84rpx;background:#F3F4F6;border-radius:16rpx;padding:0 24rpx;font-size:28rpx;box-sizing:border-box;margin-bottom:20rpx}
.modal-actions{display:flex;gap:20rpx;margin-top:12rpx}
.modal-btn{flex:1;margin:0;font-size:28rpx;font-weight:700;border-radius:16rpx;line-height:84rpx;height:84rpx}
.modal-btn::after{border:none}
.modal-btn.cancel{background:#F3F4F6;color:#6B7280}
.modal-btn.confirm{background:linear-gradient(135deg,#7C3AED,#A78BFA);color:#fff}
