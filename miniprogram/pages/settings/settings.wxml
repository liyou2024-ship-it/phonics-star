<view class="page">
  <view class="page-header">
    <view class="avatar">{{userId ? userId.charAt(0) : '?'}}</view>
    <text class="title">账户设置</text>
    <text class="sub">{{loginStatus}}</text>
  </view>

  <view class="account-card">
    <view class="card-title">账户管理</view>

    <view class="menu-item" bindtap="onOpenPwdModal">
      <text class="mi-icon">🔑</text><text class="mi-label">修改密码</text><text class="mi-arrow">→</text>
    </view>

    <view class="menu-item" bindtap="onLogout">
      <text class="mi-icon">🚪</text><text class="mi-label">退出登录</text><text class="mi-arrow">→</text>
    </view>

    <view class="menu-item danger" bindtap="onDeleteAccount">
      <text class="mi-icon">🗑️</text><text class="mi-label">注销账号</text><text class="mi-arrow">→</text>
    </view>
  </view>

  <!-- 修改密码弹窗 -->
  <view class="modal-mask" wx:if="{{showPwdModal}}" bindtap="onClosePwdModal">
    <view class="modal" catchtap="noop">
      <view class="modal-title">修改密码</view>
      <input class="modal-input" placeholder="请输入原密码" password value="{{oldPwd}}" bindinput="onOldPwdInput" />
      <input class="modal-input" placeholder="请输入新密码" password value="{{newPwd}}" bindinput="onNewPwdInput" />
      <input class="modal-input" placeholder="请再次输入新密码" password value="{{confirmPwd}}" bindinput="onConfirmPwdInput" />
      <view class="modal-actions">
        <button class="modal-btn cancel" bindtap="onClosePwdModal">取消</button>
        <button class="modal-btn confirm" bindtap="onSubmitChangePwd" loading="{{pwdSaving}}">确认修改</button>
      </view>
    </view>
  </view>
</view>
