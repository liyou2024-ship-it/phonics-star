/* ===== 页面容器 ===== */
.page {
  padding: 24rpx 24rpx 120rpx;
  background: #f5f3ff;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 状态视图 ===== */
.state-view {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.state-text {
  font-size: 30rpx;
  color: #9ca3af;
}

.retry-btn {
  margin-top: 24rpx;
  padding: 16rpx 48rpx;
  background: #7c3aed;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: inline-block;
}

/* ===== 时间范围切换 ===== */
.time-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.time-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #6b7280;
  background: #fff;
  border-radius: 40rpx;
  border: 2rpx solid #e5e7eb;
  transition: all 0.2s;
}

.time-tab--active {
  background: #7c3aed;
  color: #fff;
  border-color: #7c3aed;
  font-weight: 700;
}

/* ===== 卡片 ===== */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(124, 58, 237, 0.06);
}

.card-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1f2937;
  display: block;
  margin-bottom: 20rpx;
}

/* ===== 2×2 统计网格 ===== */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.stat-item {
  text-align: center;
  padding: 16rpx 0;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 900;
  color: #7c3aed;
  display: block;
  line-height: 1.2;
}

.stat-label {
  font-size: 24rpx;
  color: #9ca3af;
  display: block;
  margin-top: 6rpx;
}

/* ===== 已掌握 ===== */
.mastered-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 60rpx;
}

.mastered-item {
  text-align: center;
}

.mastered-value {
  font-size: 48rpx;
  font-weight: 900;
  color: #22c55e;
  display: block;
}

.mastered-label {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 4rpx;
  display: block;
}

.mastered-divider {
  width: 2rpx;
  height: 64rpx;
  background: #e5e7eb;
}

/* ===== 弱音素列表 ===== */
.weak-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.weak-item {
  padding: 20rpx;
  border-radius: 16rpx;
  border-left: 8rpx solid #e5e7eb;
  background: #fafafa;
}

.weak-item--high {
  border-left-color: #ef4444;
  background: #fef2f2;
}

.weak-item--medium {
  border-left-color: #f59e0b;
  background: #fffbeb;
}

.weak-item--low {
  border-left-color: #3b82f6;
  background: #eff6ff;
}

.weak-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.weak-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #1f2937;
}

.weak-symbol {
  font-size: 24rpx;
  color: #6b7280;
  font-style: italic;
}

.weak-mock-tag {
  font-size: 22rpx;
  color: #f59e0b;
  background: #fffbeb;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  border: 1rpx solid #fcd34d;
}

.weak-details {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.weak-detail {
  font-size: 24rpx;
  color: #6b7280;
  background: #fff;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.weak-score {
  font-size: 24rpx;
  color: #9ca3af;
  display: block;
}

/* ===== 课程列表 ===== */
.course-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.course-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: #f9fafb;
  border-radius: 12rpx;
}

.course-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.course-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2937;
}

.course-score {
  font-size: 24rpx;
  color: #6b7280;
}

/* ===== 建议 ===== */
.card-suggestions {
  background: linear-gradient(135deg, #faf5ff 0%, #f5f3ff 100%);
}

.suggestion-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.suggestion-item {
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  border-left: 6rpx solid;
}

.suggestion-item--high {
  background: #fef2f2;
  border-left-color: #ef4444;
}

.suggestion-item--medium {
  background: #fffbeb;
  border-left-color: #f59e0b;
}

.suggestion-item--low {
  background: #eff6ff;
  border-left-color: #3b82f6;
}

.suggestion-text {
  font-size: 26rpx;
  color: #374151;
  line-height: 1.7;
}

.no-suggestion {
  font-size: 26rpx;
  color: #9ca3af;
  text-align: center;
  padding: 20rpx 0;
}

/* ===== 数据说明 ===== */
.data-note {
  padding: 20rpx 28rpx;
  background: #fffbeb;
  border-radius: 16rpx;
  border: 1rpx solid #fcd34d;
  margin-bottom: 20rpx;
}

.note-text {
  font-size: 24rpx;
  color: #92400e;
  line-height: 1.6;
}
