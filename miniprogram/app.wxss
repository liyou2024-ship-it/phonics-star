/* 自然拼读星 - 全局样式 */
page {
  --primary: #7C3AED;
  --primary-light: #A78BFA;
  --primary-bg: #F5F3FF;
  --secondary: #F59E0B;
  --success: #10B981;
  --danger: #EF4444;
  --text: #1F2937;
  --text-light: #6B7280;
  --text-lighter: #9CA3AF;
  --bg: #FAFAFA;
  --card-bg: #FFFFFF;
  --border: #E5E7EB;

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  color: var(--text);
  background: var(--bg);
  box-sizing: border-box;
}

/* 通用按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 32rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #7C3AED, #A78BFA);
  color: #fff;
}

.btn-secondary {
  background: #F3E8FF;
  color: #7C3AED;
}
